# Rebuildable data: the database, the HTTP cache, the demo
data/*.duckdb
data/*.duckdb.wal
data/cache/
data/season.json
data/demo/
*.parquet

# Python tooling
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# data artefacts - never commit, they are rebuildable
data/*.duckdb
data/*.duckdb.wal
data/cache/
data/fastf1_cache/
*.parquet

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# outputs that ARE committed live in predictions/ and reports/
reports/*.tmp

# os
.DS_Store

# delivery scratch - screenshots, zips and superseded forecasts. Kept on disk
# so nothing is lost, kept out of the repo so the published tree is only what
# the project needs to run.
*outputs/
_superseded/
models_out/

_gitjunk/

# local transfer artefacts and working notes; contents already in the tree
*.tar.gz
APPLY-THIS.md
PUSH-TO-GITHUB.md

# personal working notes - the plain-English explainer and resume text. Kept on
# disk, deliberately not published.
docs/

# Generated every run and deployed from the Pages artifact, not from the repo.
# Tracking them meant two runs could edit the same file and collide, and a
# content conflict in a generated file never auto-resolves - it just wedged the
# rebase and lost the forecast that had already been computed.
reports/*.html

# Latest season projection, rebuilt every run.
data/season.json
